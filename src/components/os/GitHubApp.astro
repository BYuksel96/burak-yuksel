---
import { GITHUB_REPOS_ENDPOINT } from '../../scripts/github-app.js';
import '../../styles/github-app.css';
---

<section
  class="github-app"
  data-github-app
  data-github-endpoint={GITHUB_REPOS_ENDPOINT}
  aria-label="GitHub repository explorer"
>
  <header class="github-app__header">
    <div class="github-app__heading">
      <p class="github-app__eyebrow">Repo Explorer</p>
      <h3>Latest public repositories</h3>
    </div>

    <div class="github-app__status-card" aria-live="polite">
      <span class="github-app__status-dot" aria-hidden="true"></span>
      <span data-github-status>Waiting for GitHub.exe to open</span>
      <strong data-github-count>0 repos</strong>
    </div>
  </header>

  <div class="github-app__workspace">
    <aside class="github-app__sidebar" aria-label="GitHub connection details">
      <div class="github-app__panel-head">
        <span class="github-app__panel-title">Connection</span>
        <span class="github-app__panel-count">Public API</span>
      </div>

      <div class="github-app__profile">
        <div class="github-app__profile-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58 0-.29-.01-1.06-.02-2.09-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.35-1.77-1.35-1.77-1.11-.76.08-.74.08-.74 1.22.09 1.87 1.26 1.87 1.26 1.09 1.86 2.86 1.32 3.56 1.01.11-.8.43-1.32.78-1.62-2.67-.3-5.48-1.33-5.48-5.92 0-1.31.47-2.38 1.25-3.22-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.64.25 2.86.12 3.16.78.84 1.24 1.91 1.24 3.22 0 4.6-2.82 5.61-5.5 5.91.44.38.83 1.13.83 2.28 0 1.65-.02 2.98-.02 3.39 0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
          </svg>
        </div>
        <div>
          <span class="github-app__profile-label">Source</span>
          <strong>BYuksel96</strong>
          <p>Six most recently updated public repositories.</p>
        </div>
      </div>

      <dl class="github-app__meta-list">
        <div>
          <dt>Sort</dt>
          <dd>Updated</dd>
        </div>
        <div>
          <dt>Limit</dt>
          <dd>6 repos</dd>
        </div>
        <div>
          <dt>Mode</dt>
          <dd>Browser fetch</dd>
        </div>
      </dl>
    </aside>

    <section class="github-app__repo-panel" aria-label="Repository results">
      <div class="github-app__panel-head">
        <span class="github-app__panel-title">Repositories</span>
        <span class="github-app__panel-count">Live public data</span>
      </div>

      <div class="github-app__state github-app__state--loading" data-github-loading aria-hidden="true" hidden>
        <span class="github-app__loader" aria-hidden="true"></span>
        <h4>Connecting to GitHub...</h4>
        <p>Fetching the latest public repositories.</p>
      </div>

      <div class="github-app__state github-app__state--error" data-github-error aria-hidden="true" hidden>
        <h4>GitHub could not be reached</h4>
        <p data-github-error-message>GitHub repositories could not be loaded.</p>
        <button class="github-app__retry" type="button" data-github-retry>Retry</button>
      </div>

      <div class="github-app__state github-app__state--empty" data-github-empty aria-hidden="true" hidden>
        <h4>No repositories returned</h4>
        <p>The public API did not return any repositories for this profile.</p>
      </div>

      <div class="github-app__success" data-github-success aria-hidden="true" hidden>
        <div class="github-app__repo-grid" data-github-repo-grid></div>
      </div>
    </section>
  </div>

  <template data-github-repo-template>
    <article class="github-app__repo-card">
      <div class="github-app__repo-main">
        <h4 data-github-repo-name></h4>
        <p data-github-repo-description></p>
      </div>

      <div class="github-app__repo-meta" aria-label="Repository metadata">
        <span>
          <span class="github-app__language-dot" aria-hidden="true"></span>
          <span data-github-repo-language></span>
        </span>
        <span>
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="m12 3 2.78 5.63 6.22.9-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.53l6.22-.9L12 3z" />
          </svg>
          <span data-github-repo-stars></span>
        </span>
        <span>
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M7 7h10M7 12h10M7 17h6" />
            <path d="M5 3h14v18H5z" />
          </svg>
          <span data-github-repo-commits></span>
        </span>
        <span>
          Updated <span data-github-repo-updated></span>
        </span>
      </div>

      <a class="github-app__repo-link" href="https://github.com/BYuksel96" target="_blank" rel="noreferrer" data-github-repo-link>
        Open on GitHub
      </a>
    </article>
  </template>
</section>

<script>
  import { initGitHubApps } from '../../scripts/github-app.js';

  if (typeof window !== 'undefined') {
    const setupGitHubApp = () => initGitHubApps(document);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGitHubApp, { once: true });
    } else {
      setupGitHubApp();
    }
  }
</script>
