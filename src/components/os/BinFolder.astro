<div class="os-folder os-folder--bin" aria-label="Bin folder contents">
  <p class="os-folder-helper">Open hidden files from the Bin</p>

  <div class="os-folder-file-grid">
    <button
      class="os-folder-file os-folder-file--game"
      type="button"
      data-os-game-file
      data-os-target="maze"
      aria-controls="os-window-maze"
      aria-label="Open Maze.exe"
    >
      <span class="os-folder-file-icon" aria-hidden="true">
        <svg viewBox="0 0 42 42" focusable="false">
          <path class="os-folder-file-paper" d="M6 6h30v30H6z" />
          <path class="os-folder-file-mark" d="M12 12h18v6H18v6h12v6H12z" />
          <path class="os-folder-file-badge" d="M24 24h6v6h-6z" />
        </svg>
      </span>
      <span class="os-folder-file-name">Maze.exe</span>
    </button>
  </div>
</div>
