<div class="os-folder os-folder--bin" aria-label="Bin folder contents" data-i18n-aria-label="bin.aria">
  <p class="os-folder-helper" data-i18n="bin.helper">Open hidden files from the Bin</p>

  <div class="os-folder-file-grid">
    <button
      class="os-folder-file os-folder-file--game"
      type="button"
      data-os-game-file
      data-os-target="maze"
      aria-controls="os-window-maze"
      aria-label="Open Maze.exe"
      data-i18n-aria-label="os.launchers.openMaze"
    >
      <span class="os-folder-file-icon" aria-hidden="true">
        <svg viewBox="0 0 42 42" focusable="false">
          <path class="os-folder-file-paper" d="M6 6h30v30H6z" />
          <path class="os-folder-file-mark" d="M12 12h18v6H18v6h12v6H12z" />
          <path class="os-folder-file-badge" d="M24 24h6v6h-6z" />
        </svg>
      </span>
      <span class="os-folder-file-name">Maze.exe</span>
    </button>

    <button
      class="os-folder-file os-folder-file--game"
      type="button"
      data-os-game-file
      data-os-target="quiz"
      aria-controls="os-window-quiz"
      aria-label="Open Quiz.exe"
      data-i18n-aria-label="os.launchers.openQuiz"
    >
      <span class="os-folder-file-icon" aria-hidden="true">
        <svg viewBox="0 0 42 42" focusable="false">
          <path class="os-folder-file-paper" d="M6 6h30v30H6z" />
          <path class="os-folder-file-mark" d="M12 12h18v4H12z" />
          <path class="os-folder-file-mark" d="M12 20h12v4H12z" />
          <path class="os-folder-file-badge" d="M27 20h5v5h-5z" />
          <path class="os-folder-file-mark" d="M12 28h18v3H12z" />
        </svg>
      </span>
      <span class="os-folder-file-name">Quiz.exe</span>
    </button>
  </div>
</div>
