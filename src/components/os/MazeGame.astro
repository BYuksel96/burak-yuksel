---
import '../../styles/maze-game.css';
---

<section class="maze-game" data-maze-game aria-label="Maze.exe 8-bit maze game" data-i18n-aria-label="maze.aria">
  <div class="maze-game__hud" aria-label="Maze game status" data-i18n-aria-label="maze.statusAria">
    <div>
      <span data-i18n="maze.level">Level</span>
      <strong data-maze-level>1</strong>
    </div>
    <div>
      <span data-i18n="maze.score">Score</span>
      <strong data-maze-score>0</strong>
    </div>
    <div>
      <span data-i18n="maze.high">High</span>
      <strong data-maze-high-score>0</strong>
    </div>
  </div>

  <div class="maze-game__stage">
    <canvas class="maze-game__canvas" data-maze-canvas aria-label="Maze playfield" data-i18n-aria-label="maze.playfield"></canvas>

    <div class="maze-game__overlay maze-game__overlay--start" data-maze-start-screen>
      <p class="maze-game__eyebrow" data-i18n="maze.recovered">Recycle Bin file recovered</p>
      <h3 data-i18n="maze.title">Maze.exe</h3>
      <section class="maze-game__how-to-play" aria-labelledby="maze-how-to-play-title">
        <h4 id="maze-how-to-play-title" data-i18n="maze.howToPlay">HOW TO PLAY</h4>
        <p data-i18n="maze.objective">Find the opening in the outer wall to escape each maze.</p>
        <p data-i18n="maze.controls">Move with Arrow keys, WASD, or the touch D-pad.</p>
        <p data-i18n="maze.rules">
          Collect items for bonus points. A new random maze appears every level. From Level 3, gateways shift nearby routes.
          From Level 6, monsters appear after you leave the start. From Level 11, a second monster joins - one touch ends the run.
        </p>
        <p data-i18n="maze.countdown">Each level begins after a 3, 2, 1 countdown.</p>
      </section>
      <div class="maze-game__actions maze-game__actions--start">
        <button class="maze-game__button maze-game__button--primary" type="button" data-maze-play data-i18n="maze.play">Play</button>
        <button class="maze-game__button" type="button" data-maze-music-toggle aria-pressed="false" data-i18n="maze.musicOff">MUSIC: OFF</button>
      </div>
    </div>

    <div class="maze-game__overlay maze-game__overlay--countdown" data-maze-countdown aria-hidden="true" hidden>
      <span data-maze-countdown-value>3</span>
    </div>

    <div class="maze-game__overlay maze-game__overlay--paused" data-maze-paused aria-hidden="true" hidden>
      <h3 data-i18n="maze.paused">Paused</h3>
      <p data-i18n="maze.pausedCopy">Maze.exe is waiting for the active window to return.</p>
    </div>

    <div class="maze-game__overlay maze-game__overlay--game-over" data-maze-game-over aria-hidden="true" hidden>
      <p class="maze-game__eyebrow" data-i18n="maze.runEnded">Run ended</p>
      <h3 data-i18n="maze.gameOver">Game Over</h3>
      <dl class="maze-game__summary">
        <div>
          <dt data-i18n="maze.finalScore">Final score</dt>
          <dd data-maze-final-score>0</dd>
        </div>
        <div>
          <dt data-i18n="maze.highestLevel">Highest level</dt>
          <dd data-maze-highest-level>1</dd>
        </div>
        <div>
          <dt data-i18n="maze.highScore">High score</dt>
          <dd data-maze-game-over-high-score>0</dd>
        </div>
      </dl>
      <p class="maze-game__new-high" data-maze-new-high-score aria-live="polite"></p>
      <div class="maze-game__actions">
        <button class="maze-game__button" type="button" data-maze-music-toggle aria-pressed="false" data-i18n="maze.musicOff">MUSIC: OFF</button>
        <button class="maze-game__button maze-game__button--primary" type="button" data-maze-restart data-i18n="maze.playAgain">Play again</button>
        <button class="maze-game__button" type="button" data-os-game-exit data-i18n="maze.exitToBin">Exit to Bin</button>
      </div>
    </div>
  </div>

  <div class="maze-game__controls" aria-label="Maze touch controls" data-i18n-aria-label="maze.controlsAria">
    <button type="button" data-maze-direction="north" aria-label="Move up" data-i18n-aria-label="maze.moveUp">
      <span aria-hidden="true">^</span>
    </button>
    <button type="button" data-maze-direction="west" aria-label="Move left" data-i18n-aria-label="maze.moveLeft">
      <span aria-hidden="true">&lt;</span>
    </button>
    <button type="button" data-maze-direction="south" aria-label="Move down" data-i18n-aria-label="maze.moveDown">
      <span aria-hidden="true">v</span>
    </button>
    <button type="button" data-maze-direction="east" aria-label="Move right" data-i18n-aria-label="maze.moveRight">
      <span aria-hidden="true">&gt;</span>
    </button>
  </div>
</section>

<script>
  import { initMazeGames } from '../../scripts/maze-game.js';

  if (typeof window !== 'undefined') {
    const setupMazeGame = () => initMazeGames(document);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMazeGame, { once: true });
    } else {
      setupMazeGame();
    }
  }
</script>
