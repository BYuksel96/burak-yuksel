---
import DesktopIcon from './DesktopIcon.astro';
import BinFolder from './BinFolder.astro';
import BlogApp from './BlogApp.astro';
import DownloadConfirmDialog from './DownloadConfirmDialog.astro';
import DownloadsFolder from './DownloadsFolder.astro';
import GitHubApp from './GitHubApp.astro';
import HelpDialog from './HelpDialog.astro';
import LoadingScreen from './LoadingScreen.astro';
import MazeGame from './MazeGame.astro';
import MonitorFrame from './MonitorFrame.astro';
import OsWindow from './OsWindow.astro';
import QuizGame from './QuizGame.astro';
import ResumeApp from './ResumeApp.astro';
import Taskbar from './Taskbar.astro';
import { getLanguageOptions } from '../../scripts/i18n.js';
import '../../styles/os.css';

const desktopItems = [
  { id: 'resume', label: 'Resume.exe', icon: 'resume' },
  { id: 'blog', label: 'Blog.exe', icon: 'blog' },
  { id: 'github', label: 'GitHub', icon: 'github' },
  { id: 'bin', label: 'Bin', icon: 'bin' },
] as const;

const taskbarItems = [
  { id: 'resume', label: 'Resume', icon: 'resume' },
  { id: 'blog', label: 'Blog', icon: 'blog' },
  { id: 'github', label: 'GitHub', icon: 'github' },
  { id: 'downloads', label: 'Downloads', icon: 'downloads' },
  { id: 'bin', label: 'Bin', icon: 'bin' },
] as const;

const languageOptions = getLanguageOptions('en');

const windows = [
  {
    id: 'resume',
    title: 'Resume.exe',
    kind: 'main',
    label: 'Application shell',
    message: 'Phase 4 content pending.',
    helpText: "Resume.exe is an interactive timeline of Burak's professional history, experience, and achievements.",
  },
  {
    id: 'blog',
    title: 'Blog.exe',
    kind: 'main',
    label: 'Application shell',
    message: 'Blog archive loaded.',
    helpText:
      "Blog.exe contains Burak's blog archive. Archive entries open posts in internal tabs; the archive tab stays open on the left so you can return without losing open posts.",
  },
  {
    id: 'github',
    title: 'GitHub',
    kind: 'main',
    label: 'Application shell',
    message: 'GitHub repositories loaded.',
    helpText:
      "GitHub displays Burak's latest public GitHub repositories. Repository links open GitHub in a new browser tab.",
  },
  {
    id: 'downloads',
    title: 'Downloads',
    kind: 'folder',
    label: 'Folder shell',
    message: 'Resume file ready.',
    helpText: "Downloads contains downloadable files. It currently includes Burak's resume/CV.",
  },
  {
    id: 'bin',
    title: 'Bin',
    kind: 'folder',
    label: 'Folder shell',
    message: 'Easter egg files ready.',
    helpText:
      'Bin contains hidden Burak OS easter eggs. Maze.exe and Quiz.exe run entirely in the browser. Progress or high scores may be stored locally where available.',
  },
  {
    id: 'maze',
    title: 'Maze.exe',
    kind: 'game',
    label: 'Game shell',
    message: 'Maze game loaded.',
    helpText:
      'Maze.exe objective: escape through the visible opening in the exterior wall. Use Arrow keys or WASD on desktop, or the touch D-pad. Collectibles award additional points. Dynamic gateway shifts begin at Level 3. The first monster begins at Level 6 after you leave the central spawn area; a second monster begins at Level 11. Monster contact immediately ends the run. High scores are stored locally where available. Exit to Bin ends the current run. Music can be enabled or disabled from the start and game-over menus.',
  },
  {
    id: 'quiz',
    title: 'Quiz.exe',
    kind: 'game',
    label: 'Game shell',
    message: 'Quiz game loaded.',
    helpText:
      'Quiz.exe has two modes. Arcade Terminal uses lives, score, levels and streaks. Coach Console uses 12-question learning sessions and category feedback. Select one of four answers with buttons, number keys 1-4, or letter keys A-D. Explanations appear after every answer. Progress and high scores are stored locally where available. Reset Progress affects Quiz.exe only. Exit to Bin discards the active session but preserves completed progress.',
  },
] as const;
---

<main class="os-shell" aria-labelledby="os-title">
  <MonitorFrame label="Burak OS shell">
    <div class="os-screen" data-os-screen data-boot-state="booting">
      <LoadingScreen />

      <div class="os-orientation-lock" role="status" aria-live="polite">
        <div class="os-orientation-lock-card">
          <p class="os-orientation-lock-title" data-i18n="os.orientation.title">Portrait mode required</p>
          <p class="os-orientation-lock-copy" data-i18n="os.orientation.copy">Rotate your device to portrait to continue using Burak OS.</p>
        </div>
      </div>

      <div class="os-desktop-layer">
        <header class="os-topbar" aria-label="Burak OS status">
          <div class="os-system-name" data-i18n="os.topbar.systemName">Burak OS</div>
          <time class="os-status-time" data-os-status-time aria-live="polite">Thu 11 Jun 22:14</time>
          <div class="os-status-actions" aria-label="System controls">
            <div class="os-language-picker">
              <button
                class="os-status-button os-status-button--language"
                type="button"
                data-os-language-toggle
                aria-label="Language"
                title="Language"
                aria-haspopup="true"
                aria-expanded="false"
                data-i18n-aria-label="os.topbar.languageButtonLabel"
                data-i18n-title="os.topbar.languageButtonLabel"
              >
                EN
              </button>
              <div class="os-language-menu" data-os-language-menu role="menu" aria-label="Choose language" data-i18n-aria-label="language.menuLabel" hidden>
                {languageOptions.map((language) => (
                  <button
                    class="os-language-option"
                    type="button"
                    role="menuitemradio"
                    aria-checked={language.isActive ? 'true' : 'false'}
                    data-os-language-option={language.code}
                    data-active={language.isActive ? true : undefined}
                  >
                    <span>{language.shortCode}</span>
                    <span data-i18n={`language.options.${language.code}`}>{language.nativeName}</span>
                  </button>
                ))}
              </div>
            </div>
            <button
              class="os-status-button os-status-button--theme"
              type="button"
              data-os-theme-toggle
              aria-label="Switch to light theme"
              aria-pressed="false"
              title="Switch to light theme"
              data-i18n-aria-label="os.topbar.themeLight"
              data-i18n-title="os.topbar.themeLight"
            >
              <span class="os-theme-icon" aria-hidden="true">
                <svg class="os-theme-icon--sun" viewBox="0 0 24 24" focusable="false">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2" />
                  <path d="M12 20v2" />
                  <path d="m4.93 4.93 1.41 1.41" />
                  <path d="m17.66 17.66 1.41 1.41" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                  <path d="m4.93 19.07 1.41-1.41" />
                  <path d="m17.66 6.34 1.41-1.41" />
                </svg>
                <svg class="os-theme-icon--moon" viewBox="0 0 24 24" focusable="false">
                  <path d="M21 14.7A7.8 7.8 0 0 1 9.3 3a8.6 8.6 0 1 0 11.7 11.7Z" />
                </svg>
              </span>
            </button>
            <button
              class="os-status-button os-status-button--shutdown"
              type="button"
              data-os-lock-button
              aria-label="Lock screen"
              title="Lock screen"
              data-i18n-aria-label="os.topbar.lockButton"
              data-i18n-title="os.topbar.lockButton"
            >
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M12 3v8" />
                <path d="M7.2 6.9a7 7 0 1 0 9.6 0" />
              </svg>
            </button>
          </div>
        </header>

        <section class="os-desktop" aria-label="Burak OS desktop" data-i18n-aria-label="os.desktop.label">
          <div class="os-desktop-icons" aria-label="Desktop apps" data-i18n-aria-label="os.desktop.iconArea">
            {desktopItems.map((item) => (
              <DesktopIcon id={item.id} label={item.label} icon={item.icon} />
            ))}
          </div>

          <div class="os-brand-lockup">
            <div class="os-brand-mark" aria-hidden="true">BY</div>
            <h1 id="os-title" data-i18n="os.desktop.brand">Burak OS</h1>
          </div>

          <div class="os-window-layer" data-os-window-layer>
            {windows.map((window) => (
              <OsWindow id={window.id} title={window.title} kind={window.kind} helpText={window.helpText}>
                {window.id === 'resume' ? (
                  <ResumeApp />
                ) : window.id === 'blog' ? (
                  <BlogApp />
                ) : window.id === 'github' ? (
                  <GitHubApp />
                ) : window.id === 'downloads' ? (
                  <DownloadsFolder />
                ) : window.id === 'bin' ? (
                  <BinFolder />
                ) : window.id === 'maze' ? (
                  <MazeGame />
                ) : window.id === 'quiz' ? (
                  <QuizGame />
                ) : (
                  <div class="os-placeholder-panel">
                    <p class="os-placeholder-label">{window.label}</p>
                    <p class="os-placeholder-title">{window.title}</p>
                    <p class="os-placeholder-message">{window.message}</p>
                  </div>
                )}
              </OsWindow>
            ))}
          </div>

          <Taskbar items={taskbarItems} />

          <HelpDialog />
          <DownloadConfirmDialog />
        </section>
      </div>

      <div
        class="os-lock-screen"
        data-os-lock-screen
        role="dialog"
        aria-modal="true"
        aria-labelledby="os-lock-title"
        aria-hidden="true"
        tabindex="-1"
        hidden
      >
        <div class="os-lock-content">
          <p class="os-lock-kicker" data-i18n="os.lock.kicker">Burak OS</p>
          <h2 id="os-lock-title" data-i18n="os.lock.title">Locked</h2>
          <p class="os-lock-copy os-lock-copy--desktop" data-i18n="os.lock.desktop">Press Enter key to unlock</p>
          <p class="os-lock-copy os-lock-copy--touch" data-i18n="os.lock.touch">Swipe up to unlock</p>
        </div>
        <div class="os-lock-swipe-cue" data-os-lock-swipe-cue aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="m12 5 6 6" />
            <path d="m12 5-6 6" />
            <path d="M12 5v14" />
          </svg>
        </div>
      </div>
    </div>
  </MonitorFrame>
</main>

<script>
  import { initLanguageMode } from '../../scripts/i18n.js';
  import { initOsWindowManager } from '../../scripts/os-window-manager.js';

  if (typeof window !== 'undefined') {
    const setupDesktop = () => {
      const screen = document.querySelector('[data-os-screen]');
      if (!screen) return;

      initLanguageMode(screen);
      initOsWindowManager(screen);

      window.setTimeout(() => {
        screen.setAttribute('data-boot-state', 'ready');
      }, 2500);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDesktop, { once: true });
    } else {
      setupDesktop();
    }
  }
</script>
