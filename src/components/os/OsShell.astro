---
import DesktopIcon from './DesktopIcon.astro';
import HelpDialog from './HelpDialog.astro';
import LoadingScreen from './LoadingScreen.astro';
import MonitorFrame from './MonitorFrame.astro';
import OsWindow from './OsWindow.astro';
import ResumeApp from './ResumeApp.astro';
import Taskbar from './Taskbar.astro';
import '../../styles/os.css';

const desktopItems = [
  { id: 'resume', label: 'Resume.exe', icon: 'resume' },
  { id: 'blog', label: 'Blog.exe', icon: 'blog' },
  { id: 'github', label: 'GitHub', icon: 'github' },
  { id: 'bin', label: 'Bin', icon: 'bin' },
] as const;

const taskbarItems = [
  { id: 'resume', label: 'Resume', icon: 'resume' },
  { id: 'blog', label: 'Blog', icon: 'blog' },
  { id: 'github', label: 'GitHub', icon: 'github' },
  { id: 'downloads', label: 'Downloads', icon: 'downloads' },
  { id: 'bin', label: 'Bin', icon: 'bin' },
] as const;

const windows = [
  {
    id: 'resume',
    title: 'Resume.exe',
    kind: 'main',
    label: 'Application shell',
    message: 'Phase 4 content pending.',
    helpText: "Resume.exe is an interactive timeline of Burak's professional history, experience, and achievements.",
  },
  {
    id: 'blog',
    title: 'Blog.exe',
    kind: 'main',
    label: 'Application shell',
    message: 'Phase 5 content pending.',
    helpText: 'Blog.exe is a placeholder app shell for Phase 3 window behaviour.',
  },
  {
    id: 'github',
    title: 'GitHub',
    kind: 'main',
    label: 'Application shell',
    message: 'Phase 6 content pending.',
    helpText: 'GitHub is a placeholder app shell for Phase 3 window behaviour.',
  },
  {
    id: 'downloads',
    title: 'Downloads',
    kind: 'folder',
    label: 'Folder shell',
    message: 'Empty for Phase 3.',
    helpText: 'Downloads is an empty placeholder folder shell for Phase 3.',
  },
  {
    id: 'bin',
    title: 'Bin',
    kind: 'folder',
    label: 'Folder shell',
    message: 'Empty for Phase 3.',
    helpText: 'Bin is an empty placeholder folder shell for Phase 3.',
  },
] as const;
---

<main class="os-shell" aria-labelledby="os-title">
  <MonitorFrame label="Burak OS shell">
    <div class="os-screen" data-os-screen data-boot-state="booting">
      <LoadingScreen />

      <div class="os-orientation-lock" role="status" aria-live="polite">
        <div class="os-orientation-lock-card">
          <p class="os-orientation-lock-title">Portrait mode required</p>
          <p class="os-orientation-lock-copy">Rotate your device to portrait to continue using Burak OS.</p>
        </div>
      </div>

      <div class="os-desktop-layer">
        <header class="os-topbar" aria-label="Burak OS status">
          <div class="os-system-name">Burak OS</div>
          <time class="os-status-time" data-os-status-time aria-live="polite">Thu 11 Jun 22:14</time>
          <div class="os-status-actions" aria-label="System placeholder controls">
            <button class="os-status-button os-status-button--language" type="button" aria-label="Language placeholder" title="Language placeholder">
              EN
            </button>
            <button class="os-status-button os-status-button--shutdown" type="button" aria-label="Shutdown placeholder" title="Shutdown placeholder">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M12 3v8" />
                <path d="M7.2 6.9a7 7 0 1 0 9.6 0" />
              </svg>
            </button>
          </div>
        </header>

        <section class="os-desktop" aria-label="Burak OS desktop">
          <div class="os-desktop-icons" aria-label="Desktop app placeholders">
            {desktopItems.map((item) => (
              <DesktopIcon id={item.id} label={item.label} icon={item.icon} />
            ))}
          </div>

          <div class="os-brand-lockup">
            <div class="os-brand-mark" aria-hidden="true">BY</div>
            <h1 id="os-title">Burak OS</h1>
          </div>

          <div class="os-window-layer" data-os-window-layer>
            {windows.map((window) => (
              <OsWindow id={window.id} title={window.title} kind={window.kind} helpText={window.helpText}>
                {window.id === 'resume' ? (
                  <ResumeApp />
                ) : (
                  <div class="os-placeholder-panel">
                    <p class="os-placeholder-label">{window.label}</p>
                    <p class="os-placeholder-title">{window.title}</p>
                    <p class="os-placeholder-message">{window.message}</p>
                  </div>
                )}
              </OsWindow>
            ))}
          </div>

          <Taskbar items={taskbarItems} />

          <HelpDialog />
        </section>
      </div>
    </div>
  </MonitorFrame>
</main>

<script>
  import { initOsWindowManager } from '../../scripts/os-window-manager.js';

  if (typeof window !== 'undefined') {
    const setupDesktop = () => {
      const screen = document.querySelector('[data-os-screen]');
      if (!screen) return;

      initOsWindowManager(screen);

      window.setTimeout(() => {
        screen.setAttribute('data-boot-state', 'ready');
      }, 2500);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDesktop, { once: true });
    } else {
      setupDesktop();
    }
  }
</script>
