---
interface TaskbarItem {
  id: string;
  label: string;
  icon: 'resume' | 'blog' | 'github' | 'downloads' | 'bin';
}

interface Props {
  items: readonly TaskbarItem[];
}

const { items } = Astro.props as Props;
---

<nav class="os-taskbar" aria-label="Burak OS taskbar">
  <div class="taskbar-items">
    {items.map((item, index) => (
      <>
        {index === 3 && <span class="taskbar-separator" aria-hidden="true"></span>}
        <button
          class={`taskbar-item taskbar-item--${item.icon}`}
          type="button"
          data-os-launcher="taskbar"
          data-os-target={item.id}
          aria-controls={`os-window-${item.id}`}
          aria-label={`Open ${item.label}`}
          aria-pressed="false"
          title={item.label}
        >
          <span class="taskbar-icon" aria-hidden="true">
            {item.icon === 'resume' && (
              <svg viewBox="0 0 32 32" focusable="false">
                <path class="icon-paper" d="M9 4h10l5 5v19H9z" />
                <path class="icon-line" d="M19 4v6h6M12 15h10M12 20h8" />
              </svg>
            )}
            {item.icon === 'blog' && (
              <svg viewBox="0 0 32 32" focusable="false">
                <path class="icon-paper" d="M7 6h18v20H7z" />
                <path class="icon-line" d="M11 13h10M11 17h10M11 21h6" />
              </svg>
            )}
            {item.icon === 'github' && (
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58 0-.29-.01-1.06-.02-2.09-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.35-1.77-1.35-1.77-1.11-.76.08-.74.08-.74 1.22.09 1.87 1.26 1.87 1.26 1.09 1.86 2.86 1.32 3.56 1.01.11-.8.43-1.32.78-1.62-2.67-.3-5.48-1.33-5.48-5.92 0-1.31.47-2.38 1.25-3.22-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.64.25 2.86.12 3.16.78.84 1.24 1.91 1.24 3.22 0 4.6-2.82 5.61-5.5 5.91.44.38.83 1.13.83 2.28 0 1.65-.02 2.98-.02 3.39 0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
              </svg>
            )}
            {item.icon === 'downloads' && (
              <svg viewBox="0 0 32 32" focusable="false">
                <path class="icon-paper" d="M6 11h20v15H6z" />
                <path class="icon-accent" d="M6 11l3-5h7l3 5" />
                <path class="icon-line" d="M16 14v8M12 18l4 4 4-4" />
              </svg>
            )}
            {item.icon === 'bin' && (
              <svg viewBox="0 0 32 32" focusable="false">
                <path class="icon-paper" d="M10 11h12l-1 16H11z" />
                <path class="icon-line" d="M8 9h16M13 9V6h6v3" />
              </svg>
            )}
          </span>
          <span class="taskbar-label">{item.label}</span>
        </button>
      </>
    ))}
  </div>
</nav>
