---
import '../../styles/quiz-game.css';
---

<section class="quiz-game" data-quiz-game aria-label="Quiz.exe Agile delivery quiz game" data-i18n-aria-label="quiz.aria">
  <div class="quiz-game__live" data-quiz-live role="status" aria-live="polite"></div>

  <section class="quiz-game__screen quiz-game__screen--start" data-quiz-screen="start" aria-labelledby="quiz-start-title">
    <div class="quiz-game__start-copy">
      <p class="quiz-game__eyebrow" data-i18n="quiz.recovered">Recovered training program</p>
      <h3 id="quiz-start-title" data-i18n="quiz.title">Quiz.exe</h3>
      <p data-i18n="quiz.intro">
        Corrupted delivery simulator restored. Choose a mode, answer carefully, and see which parts of the Agile system still hold under pressure.
      </p>
    </div>

    <div class="quiz-game__mode-grid" aria-label="Quiz game modes" data-i18n-aria-label="quiz.modesAria">
      <button class="quiz-game__mode-card" type="button" data-quiz-start-mode="arcade">
        <span data-i18n="quiz.arcadeTerminal">Arcade Terminal</span>
        <strong data-i18n="quiz.arcadeSummary">Lives + streaks</strong>
        <small data-i18n="quiz.arcadeCopy">Fast-paced delivery challenge. Protect your lives, build streaks and chase a high score.</small>
      </button>

      <button class="quiz-game__mode-card" type="button" data-quiz-start-mode="coach">
        <span data-i18n="quiz.coachConsole">Coach Console</span>
        <strong data-i18n="quiz.coachSummary">12-question session</strong>
        <small data-i18n="quiz.coachCopy">Work through realistic situations, review explanations and improve weaker knowledge areas.</small>
      </button>
    </div>

    <div class="quiz-game__progress" data-quiz-progress-summary>
      <p data-i18n="quiz.progressLoading">Local progress loading...</p>
    </div>

    <div class="quiz-game__actions">
      <button class="quiz-game__button" type="button" data-quiz-reset-progress data-i18n="quiz.resetProgress">Reset Progress</button>
      <button class="quiz-game__button" type="button" data-os-game-exit data-i18n="quiz.exitToBin">Exit to Bin</button>
    </div>

    <div class="quiz-game__confirm" data-quiz-reset-confirm hidden>
      <p data-i18n="quiz.resetConfirm">Clear Quiz.exe high scores and learning progress?</p>
      <div>
        <button class="quiz-game__button quiz-game__button--danger" type="button" data-quiz-confirm-reset data-i18n="quiz.yesReset">Yes, reset</button>
        <button class="quiz-game__button" type="button" data-quiz-cancel-reset data-i18n="quiz.no">No</button>
      </div>
    </div>
  </section>

  <section class="quiz-game__screen quiz-game__screen--play" data-quiz-screen="play" aria-labelledby="quiz-question-title" hidden>
    <div class="quiz-game__hud" aria-label="Quiz status" data-i18n-aria-label="quiz.statusAria">
      <div>
        <span data-i18n="quiz.mode">Mode</span>
        <strong data-quiz-mode-label>Arcade</strong>
      </div>
      <div data-quiz-arcade-stat>
        <span data-i18n="quiz.lives">Lives</span>
        <strong data-quiz-lives>3</strong>
      </div>
      <div data-quiz-arcade-stat>
        <span data-i18n="quiz.level">Level</span>
        <strong data-quiz-level>1</strong>
      </div>
      <div>
        <span data-i18n="quiz.score">Score</span>
        <strong data-quiz-score>0</strong>
      </div>
      <div data-quiz-arcade-stat>
        <span data-i18n="quiz.streak">Streak</span>
        <strong data-quiz-streak>0</strong>
      </div>
      <div data-quiz-coach-stat hidden>
        <span data-i18n="quiz.question">Question</span>
        <strong><span data-quiz-coach-index>1</span>/12</strong>
      </div>
    </div>

    <div class="quiz-game__question-shell">
      <div class="quiz-game__prompt">
        <p class="quiz-game__meta">
          <span data-quiz-category>Agile principles</span>
          <span data-quiz-difficulty>Foundation</span>
        </p>
        <p class="quiz-game__scenario" data-quiz-scenario hidden></p>
        <h3 id="quiz-question-title" data-quiz-prompt>Question prompt</h3>
      </div>

      <div class="quiz-game__answers" data-quiz-answers aria-label="Answer choices" data-i18n-aria-label="quiz.answerChoices">
        <button class="quiz-game__answer" type="button" data-quiz-answer data-choice-id="a">
          <span>A</span>
          <strong></strong>
        </button>
        <button class="quiz-game__answer" type="button" data-quiz-answer data-choice-id="b">
          <span>B</span>
          <strong></strong>
        </button>
        <button class="quiz-game__answer" type="button" data-quiz-answer data-choice-id="c">
          <span>C</span>
          <strong></strong>
        </button>
        <button class="quiz-game__answer" type="button" data-quiz-answer data-choice-id="d">
          <span>D</span>
          <strong></strong>
        </button>
      </div>

      <section class="quiz-game__feedback" data-quiz-feedback aria-live="polite" hidden>
        <p class="quiz-game__feedback-title" data-quiz-feedback-title data-i18n="quiz.correct">Correct</p>
        <p data-quiz-feedback-copy></p>
        <p data-quiz-why-it-matters></p>
        <a data-quiz-reference href="#" target="_blank" rel="noreferrer" hidden data-i18n="quiz.source">Source</a>
        <div class="quiz-game__actions">
          <button class="quiz-game__button quiz-game__button--primary" type="button" data-quiz-next data-i18n="quiz.next">Next</button>
          <button class="quiz-game__button" type="button" data-quiz-mode-select data-i18n="quiz.modeSelect">Mode Select</button>
          <button class="quiz-game__button" type="button" data-os-game-exit data-i18n="quiz.exitToBin">Exit to Bin</button>
        </div>
      </section>
    </div>
  </section>

  <section class="quiz-game__screen quiz-game__screen--summary" data-quiz-screen="arcade-summary" aria-labelledby="quiz-arcade-summary-title" hidden>
    <p class="quiz-game__eyebrow" data-i18n="quiz.runEnded">Run ended</p>
    <h3 id="quiz-arcade-summary-title" data-i18n="quiz.arcadeTerminal">Arcade Terminal</h3>
    <p class="quiz-game__new-high" data-quiz-new-high aria-live="polite"></p>
    <dl class="quiz-game__summary-list">
      <div>
        <dt data-i18n="quiz.finalScore">Final score</dt>
        <dd data-quiz-final-score>0</dd>
      </div>
      <div>
        <dt data-i18n="quiz.highestLevel">Highest level</dt>
        <dd data-quiz-highest-level>1</dd>
      </div>
      <div>
        <dt data-i18n="quiz.longestStreak">Longest streak</dt>
        <dd data-quiz-longest-streak>0</dd>
      </div>
      <div>
        <dt data-i18n="quiz.highScore">High score</dt>
        <dd data-quiz-final-high-score>0</dd>
      </div>
    </dl>
    <div class="quiz-game__actions">
      <button class="quiz-game__button quiz-game__button--primary" type="button" data-quiz-start-mode="arcade" data-i18n="quiz.playAgain">Play Again</button>
      <button class="quiz-game__button" type="button" data-quiz-mode-select data-i18n="quiz.returnModeSelect">Return to Mode Select</button>
      <button class="quiz-game__button" type="button" data-os-game-exit data-i18n="quiz.exitToBin">Exit to Bin</button>
    </div>
  </section>

  <section class="quiz-game__screen quiz-game__screen--summary" data-quiz-screen="coach-summary" aria-labelledby="quiz-coach-summary-title" hidden>
    <p class="quiz-game__eyebrow" data-i18n="quiz.learningSummary">Learning session summary</p>
    <h3 id="quiz-coach-summary-title" data-i18n="quiz.coachConsole">Coach Console</h3>
    <p data-quiz-coach-score>0 correct out of 12</p>
    <div class="quiz-game__coach-summary" data-quiz-coach-summary></div>
    <div class="quiz-game__actions">
      <button class="quiz-game__button quiz-game__button--primary" type="button" data-quiz-start-mode="coach" data-i18n="quiz.startAnother">Start Another Session</button>
      <button class="quiz-game__button" type="button" data-quiz-mode-select data-i18n="quiz.returnModeSelect">Return to Mode Select</button>
      <button class="quiz-game__button" type="button" data-os-game-exit data-i18n="quiz.exitToBin">Exit to Bin</button>
    </div>
  </section>
</section>

<script>
  import { initQuizGames } from '../../scripts/quiz-game.js';

  if (typeof window !== 'undefined') {
    const setupQuizGame = () => initQuizGames(document);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQuizGame, { once: true });
    } else {
      setupQuizGame();
    }
  }
</script>
