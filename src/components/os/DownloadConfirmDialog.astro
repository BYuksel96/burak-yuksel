<section class="os-download-confirm-layer" data-os-download-confirm aria-hidden="true" hidden>
  <button class="os-download-confirm-backdrop" type="button" data-os-download-confirm-no aria-label="Cancel download"></button>
  <article class="os-download-confirm-panel" role="dialog" aria-modal="true" aria-labelledby="os-download-confirm-title">
    <h2 id="os-download-confirm-title">Continue download Burak's Resume?</h2>
    <div class="os-download-confirm-actions">
      <button class="os-download-confirm-button os-download-confirm-button--yes" type="button" data-os-download-confirm-yes>
        Yes
      </button>
      <button class="os-download-confirm-button os-download-confirm-button--no" type="button" data-os-download-confirm-no>
        No
      </button>
    </div>
  </article>
</section>
