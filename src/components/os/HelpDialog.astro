<section class="os-help-layer" data-os-help-dialog aria-hidden="true" hidden>
  <button class="os-help-backdrop" type="button" data-os-help-close aria-label="Close help dialog"></button>
  <article class="os-help-panel" role="dialog" aria-modal="true" aria-labelledby="os-help-title">
    <div class="os-help-header">
      <button class="os-help-close" type="button" data-os-help-close data-os-help-close-button aria-label="Close help dialog">
        <span aria-hidden="true">X</span>
      </button>
      <h2 id="os-help-title" data-os-help-title>Help</h2>
    </div>
    <p data-os-help-copy></p>
  </article>
</section>
