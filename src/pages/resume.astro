          <a class="mobile-nav-item" href="https://github.com/BYuksel96" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58 0-.29-.01-1.06-.02-2.09-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.35-1.77-1.35-1.77-1.11-.76.08-.74.08-.74 1.22.09 1.87 1.26 1.87 1.26 1.09 1.86 2.86 1.32 3.56 1.01.11-.8.43-1.32.78-1.62-2.67-.3-5.48-1.33-5.48-5.92 0-1.31.47-2.38 1.25-3.22-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.64.25 2.86.12 3.16.78.84 1.24 1.91 1.24 3.22 0 4.6-2.82 5.61-5.5 5.91.44.38.83 1.13.83 2.28 0 1.65-.02 2.98-.02 3.39 0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a class="mobile-nav-item" href={`${base}Resume-BURAK-YUKSEL.pdf`} download>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 3v12" />
              <path d="M7 11l5 5 5-5" />
              <path d="M5 19h14" />
            </svg>
            <span>Download CV</span>
          </a>
          <a class="mobile-nav-item" href="https://www.linkedin.com/in/burak-yuksel96/" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.2 8.1h4.6V24H.2zM8.4 8.1h4.4v2.2h.06c.62-1.2 2.14-2.47 4.42-2.47 4.73 0 5.6 3.11 5.6 7.15V24h-4.6v-7.42c0-1.77-.03-4.05-2.47-4.05-2.47 0-2.85 1.93-2.85 3.92V24H8.4z" />
            </svg>
            <span>LinkedIn Profile</span>
          </a>
        </div>
      </div>
    </footer>

    <div class="modal-backdrop" aria-hidden="true">
      <div class="modal">
        <header class="modal-head">
          <div class="modal-title">
            <h3 id="modalTitle"></h3>
            <span class="muted" id="modalDate"></span>
          </div>
          <button class="modal-close" aria-label="Close modal">X</button>
        </header>
        <div class="modal-body" id="modalBody"></div>
        <button class="modal-scroll" type="button" aria-label="Scroll to bottom">V</button>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script>
    if (typeof window !== 'undefined') {
      window.addEventListener('DOMContentLoaded', () => {
        const timelineEl = document.querySelector('.timeline');
        const solid = document.querySelector('.spine.solid');
        const dotted = document.querySelector('.spine.dotted');
        const current = document.querySelector('.timeline-row[data-current="true"]');
        const items = document.querySelectorAll('.timeline-row');
        const modalBackdrop = document.querySelector('.modal-backdrop');
        const modal = document.querySelector('.modal');
        const modalTitle = document.getElementById('modalTitle');
        const modalDate = document.getElementById('modalDate');
        const modalBody = document.getElementById('modalBody');
        const closeBtn = document.querySelector('.modal-close');
        const scrollBtn = document.querySelector('.modal-scroll');
        const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const toVh = (value) => `${(value / Math.max(window.innerHeight, 1)) * 100}vh`;

        const layoutSpine = () => {
          if (!timelineEl || !solid || !dotted || !current || items.length === 0) return;
          const tRect = timelineEl.getBoundingClientRect();
          const firstRect = items[0].getBoundingClientRect();
          const cRect = current.getBoundingClientRect();
          const startBase = firstRect.top + firstRect.height / 2 - tRect.top;
          const target = cRect.top + cRect.height / 2 - tRect.top;
          // Start slightly above the first event so the solid line overlaps the dot fully.
          const startOffset = -40;
          const start = startBase + startOffset;
          solid.style.top = toVh(start + 10);
          solid.style.height = '0';
          dotted.style.height = '0';
          dotted.style.top = toVh(target);
          dotted.style.opacity = '0';

          const solidDuration = prefersReduce ? 0 : 1;
          const dottedDuration = prefersReduce ? 0 : 0.8;
          const dottedDelay = prefersReduce ? 0 : 0.2;

          const solidHeight = Math.max(target - start, 0);
          const dottedHeight = Math.max(tRect.height - target, 0);

          gsap.to(solid, { height: toVh(solidHeight), duration: solidDuration, ease: 'power2.out' });
          gsap.to(dotted, { height: toVh(dottedHeight), duration: dottedDuration, delay: dottedDelay, ease: 'power2.out', opacity: 1 });
        };

        const refreshTimeline = () => {
          if (!timelineEl || items.length === 0) return;
          activeTimeline?.kill();
          activeTimeline = null;
          playTimelineSequence();
          layoutSpine();
        };

        const playTimelineSequence = () => {
          if (!timelineEl || !solid || !dotted || items.length === 0 || typeof gsap === 'undefined') return;

          const rows = Array.from(items);
          const dots = rows.map((row) => row.querySelector('.spine-dot'));
          const branches = rows.map((row) => row.querySelector('.branch'));
          const cards = rows.map((row) => row.querySelector('.card'));
          const cardInners = rows.map((row) => row.querySelector('.card-inner'));

          const tRect = timelineEl.getBoundingClientRect();
          const centers = rows.map((row) => {
            const rect = row.getBoundingClientRect();
            return rect.top + rect.height / 2 - tRect.top;
          });

          const rawIndex = Number(timelineEl.dataset.currentIndex);
          const safeIndex = Number.isFinite(rawIndex) && rawIndex >= 0 ? Math.min(rawIndex, rows.length - 1) : rows.length - 1;

          const firstCenter = centers[0] ?? 0;
          const currentCenter = centers[safeIndex] ?? firstCenter;
          const startOffset = -40;
          const start = firstCenter + startOffset;

          solid.style.top = toVh(start + 10);
          solid.style.height = toVh(Math.max(firstCenter - start, 0));
          dotted.style.top = toVh(currentCenter);
          dotted.style.height = '0';
          dotted.style.opacity = '0';

          rows.forEach((row, idx) => {
            const branch = branches[idx];
            if (branch) {
              const origin = row.classList.contains('left') ? '100% 50%' : '0% 50%';
              gsap.set(branch, { transformOrigin: origin });
            }
          });

          gsap.set(rows, { opacity: 1, y: 0 });
          gsap.set(dots, { autoAlpha: 0, scale: 0 });
          gsap.set(branches, { scaleX: 0 });
          gsap.set(cards, { autoAlpha: 0 });
          gsap.set(cardInners, { scale: 0.6 });

          if (prefersReduce) {
            gsap.set(dots, { autoAlpha: 1, scale: 1 });
            gsap.set(branches, { scaleX: 1 });
            gsap.set(cards, { autoAlpha: 1 });
            gsap.set(cardInners, { scale: 1 });
            layoutSpine();
            return;
          }

          solid.classList.add('shimmer');
          dotted.classList.add('shimmer');

          const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });

          rows.forEach((row, idx) => {
            const dot = dots[idx];
            const branch = branches[idx];
            const card = cards[idx];
            const inner = cardInners[idx];

            tl.to(dot, { autoAlpha: 1, scale: 1, duration: 0.2 });
            tl.call(() => {
              if (dot) dot.classList.add('pulse');
            }, [], '<');
            tl.to(branch, { scaleX: 1, duration: 0.32 }, '<');
            tl.to(card, { autoAlpha: 1, duration: 0.2 }, '<');
            tl.to(inner, { scale: 1.05, duration: 0.28 }, '<');
            tl.to(inner, { scale: 1, duration: 0.22 }, '>-15%');

            if (idx < rows.length - 1) {
              const nextCenter = centers[idx + 1];
              const lineTarget = idx < safeIndex ? solid : dotted;
              const lineHeight = idx < safeIndex ? nextCenter - start : nextCenter - currentCenter;
              if (lineTarget === dotted) {
                tl.set(dotted, { opacity: 1 });
              }
              tl.to(lineTarget, { height: toVh(Math.max(lineHeight, 0)), duration: 0.5 }, '>');
            }
          });

          if (safeIndex < rows.length - 1) {
            const dottedHeight = Math.max(tRect.height - currentCenter, 0);
            tl.to(dotted, { height: toVh(dottedHeight), duration: 0.5 }, '>');
          }
          tl.call(() => {
            solid.classList.remove('shimmer');
            dotted.classList.remove('shimmer');
          });
        };

        let activeCard = null;
        let activeOffsets = { x: 0, y: 0 };
        let activeTimeline = null;

        const openModal = (card) => {
          if (!modal || !modalBackdrop || !modalTitle || !modalDate || !modalBody) return;
          const cardInner = card.querySelector('.card-inner');
          activeCard = card;
          modalTitle.textContent = card.dataset.title || '';
          modalDate.textContent = card.dataset.date || '';
          const description = card.dataset.description || '';
          const lines = description.split('\n').map((line) => line.trim()).filter(Boolean);
          let html = '';
          let listOpen = false;
          lines.forEach((line) => {
            if (line.startsWith('-')) {
              if (!listOpen) {
                html += '<ul>';
                listOpen = true;
              }
              html += `<li>${line.replace(/^-+\s*/, '')}</li>`;
              return;
            }
            if (listOpen) {
              html += '</ul>';
              listOpen = false;
            }
            if (line.endsWith(':')) {
              html += `<p class="modal-section">${line}</p>`;
            } else {
              html += `<p>${line}</p>`;
            }
          });
          if (listOpen) html += '</ul>';
          modalBody.innerHTML = html;
          modalBackdrop.classList.add('active');
          modalBody.scrollTop = 0;
          requestAnimationFrame(() => updateScrollHint());

          activeTimeline?.kill();
          activeTimeline = null;

          if (prefersReduce) {
            gsap.set(cardInner, { rotateY: 180 });
            gsap.set(card, { autoAlpha: 0 });
            gsap.set(modal, { opacity: 1, scale: 1, x: 0, y: 0 });
            return;
          }

          // Wait a frame so the modal can measure correctly after becoming visible.
          requestAnimationFrame(() => {
            const cardRect = cardInner?.getBoundingClientRect();
            const modalRect = modal.getBoundingClientRect();
            if (!cardRect || !modalRect) return;

            const cardCenterX = cardRect.left + cardRect.width / 2;
            const cardCenterY = cardRect.top + cardRect.height / 2;
            const modalCenterX = modalRect.left + modalRect.width / 2;
            const modalCenterY = modalRect.top + modalRect.height / 2;

            activeOffsets = {
              x: cardCenterX - modalCenterX,
              y: cardCenterY - modalCenterY,
            };

            const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
            activeTimeline = tl;
            tl.set(modal, { opacity: 0, scale: 0.6, x: activeOffsets.x, y: activeOffsets.y, transformOrigin: 'center center', autoAlpha: 0 });
            tl.set(card, { autoAlpha: 1 });
            tl.to(cardInner, { rotateY: 180, duration: 0.4, ease: 'power2.inOut' });
            tl.set(card, { autoAlpha: 0 });
            tl.to(modal, { opacity: 1, autoAlpha: 1, scale: 0.9, x: 0, y: 0, duration: 0.55, ease: 'power2.out' });
            tl.to(modal, { scale: 1, duration: 0.25, ease: 'power1.out' }, '>-10%');
          });
        };

        const closeModal = () => {
          if (!modal || !modalBackdrop) return;
          const cardInner = activeCard?.querySelector('.card-inner');
          const { x, y } = activeOffsets;

          activeTimeline?.kill();
          activeTimeline = null;

          if (prefersReduce) {
            gsap.set(modal, { clearProps: 'transform,opacity' });
            if (activeCard) {
              gsap.set(activeCard, { autoAlpha: 1 });
              gsap.set(cardInner, { rotateY: 0 });
            } else {
              document.querySelectorAll('.card-inner').forEach((inner) => gsap.set(inner, { rotateY: 0 }));
            }
            modalBackdrop.classList.remove('active');
            activeCard = null;
            activeOffsets = { x: 0, y: 0 };
            return;
          }

          const tl = gsap.timeline({
            defaults: { ease: 'power2.out' },
            onComplete: () => {
              modalBackdrop.classList.remove('active');
              activeCard = null;
              activeOffsets = { x: 0, y: 0 };
            },
          });
          tl.to(modal, { opacity: 0.85, scale: 0.85, duration: 0.2 });
          tl.to(modal, { opacity: 0, autoAlpha: 0, scale: 0.6, x, y, duration: 0.45 });
          tl.set(modal, { autoAlpha: 0, clearProps: 'transform,opacity' });
          if (activeCard && cardInner) {
            tl.set(activeCard, { autoAlpha: 1 });
            tl.set(cardInner, { rotateY: 180 });
            tl.to(cardInner, { rotateY: 0, duration: 0.4, ease: 'power2.inOut' });
          } else {
            tl.call(() => {
              document.querySelectorAll('.card-inner').forEach((inner) => gsap.set(inner, { rotateY: 0 }));
            });
          }
        };

        const mobileNav = document.querySelector('.mobile-nav');
        const mobileNavToggle = document.querySelector('.mobile-nav-toggle');
        const mobileNavPanel = document.querySelector('.mobile-nav-panel');

        const setMobileNavOpen = (isOpen) => {
          if (!mobileNav || !mobileNavToggle || !mobileNavPanel) return;
          mobileNav.classList.toggle('open', isOpen);
          mobileNavToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          mobileNavPanel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        };

        document.addEventListener('click', (event) => {
          const card = (event.target instanceof Element && event.target.closest('.card')) || null;
          if (card) {
            event.preventDefault();
            openModal(card);
          }
          if (event.target instanceof Element && event.target.classList.contains('modal-backdrop')) {
            closeModal();
          }
          if (mobileNav?.classList.contains('open') && event.target instanceof Node && !mobileNav.contains(event.target)) {
            setMobileNavOpen(false);
          }
        });

        closeBtn?.addEventListener('click', closeModal);
        scrollBtn?.addEventListener('click', () => {
          if (!modalBody) return;
          modalBody.scrollTo({ top: modalBody.scrollHeight, behavior: 'smooth' });
        });
        modalBody?.addEventListener('scroll', () => {
          updateScrollHint();
        });
        modalBackdrop?.addEventListener('click', (e) => {
          if (e.target === modalBackdrop) closeModal();
        });

        const updateScrollHint = () => {
          if (!modalBody || !scrollBtn) return;
          const remaining = modalBody.scrollHeight - modalBody.scrollTop - modalBody.clientHeight;
          const shouldShow = modalBody.scrollHeight > modalBody.clientHeight && remaining > 8;
          scrollBtn.classList.toggle('visible', shouldShow);
        };

        mobileNavToggle?.addEventListener('click', () => {
          if (!mobileNav) return;
          setMobileNavOpen(!mobileNav.classList.contains('open'));
        });
        mobileNavPanel?.addEventListener('click', (event) => {
          const navItem = event.target instanceof Element ? event.target.closest('.mobile-nav-item') : null;
          if (navItem) {
            setMobileNavOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setMobileNavOpen(false);
          }
        });

        playTimelineSequence();
        if (document.fonts && typeof document.fonts.ready?.then === 'function') {
          document.fonts.ready.then(() => {
            refreshTimeline();
          });
        }
        window.addEventListener('load', () => {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => refreshTimeline());
          });
          setTimeout(() => refreshTimeline(), 350);
        });
        window.addEventListener('resize', () => {
          layoutSpine();
        });
        window.addEventListener('orientationchange', () => {
          refreshTimeline();
        });
      });
    }
  </script>
</BaseLayout>
