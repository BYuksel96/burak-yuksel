---
const base = import.meta.env.BASE_URL || '/';
const rootHref = base.endsWith('/') ? base : `${base}/`;
const targetHref = `${rootHref}#app=resume`;
const redirectScript = `window.location.replace(${JSON.stringify(targetHref)});`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${targetHref}`} />
    <link rel="canonical" href={rootHref} />
    <link rel="alternate" href={targetHref} />
    <title>Opening Resume.exe | Burak OS</title>
    <script is:inline set:html={redirectScript}></script>
  </head>
  <body>
    <main>
      <p>Opening <a href={targetHref}>Resume.exe in Burak OS</a>.</p>
    </main>
  </body>
</html>
