---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/cv.css';
import '../../styles/blog.css';

const base = import.meta.env.BASE_URL || '/';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const wordsPerMinute = 140;
const countWords = (text = '') =>
  text
    .trim()
    .split(/\s+/)
    .filter(Boolean).length;
const estimateReadMinutes = (text = '') =>
  Math.max(1, Math.ceil(countWords(text) / wordsPerMinute));

const groups = [];
posts.forEach((post) => {
  const year = post.data.pubDate.getFullYear();
  const last = groups[groups.length - 1];
  if (!last || last.year !== year) {
    groups.push({ year, posts: [post] });
  } else {
    last.posts.push(post);
  }
});

const rendered = await Promise.all(posts.map((post) => post.render()));
const renderedBySlug = new Map(posts.map((post, index) => [post.slug, rendered[index]]));

const formatRowDate = (date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: '2-digit',
  });
const formatModalDate = (date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<BaseLayout
  title="Posts"
  description="Blog posts by Burak Yuksel."
  hideHeader={true}
  bodyClass="blog-body"
  footerText="© 2026 Burak Yuksel"
>
  <div class="posts-page">
    <div class="floating-icons">
      <a class="icon-card" href={base}>
        <div class="icon-flip">
          <div class="icon-face icon-front">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M3 11.5l9-7 9 7" />
              <path d="M6.5 10.5V20h11V10.5" />
            </svg>
          </div>
          <div class="icon-face icon-back">Home</div>
        </div>
      </a>
      <a class="icon-card" href={`${base}blog/`}>
        <div class="icon-flip">
          <div class="icon-face icon-front">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M5 4h10l4 4v12H5z" />
              <path d="M15 4v4h4" />
              <path d="M8 12h8" />
              <path d="M8 15h8" />
            </svg>
          </div>
          <div class="icon-face icon-back">Blog</div>
        </div>
      </a>
      <a class="icon-card" href="https://github.com/BYuksel96" target="_blank" rel="noreferrer">
        <div class="icon-flip">
          <div class="icon-face icon-front">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58 0-.29-.01-1.06-.02-2.09-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.35-1.77-1.35-1.77-1.11-.76.08-.74.08-.74 1.22.09 1.87 1.26 1.87 1.26 1.09 1.86 2.86 1.32 3.56 1.01.11-.8.43-1.32.78-1.62-2.67-.3-5.48-1.33-5.48-5.92 0-1.31.47-2.38 1.25-3.22-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.64.25 2.86.12 3.16.78.84 1.24 1.91 1.24 3.22 0 4.6-2.82 5.61-5.5 5.91.44.38.83 1.13.83 2.28 0 1.65-.02 2.98-.02 3.39 0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
            </svg>
          </div>
          <div class="icon-face icon-back">GitHub</div>
        </div>
      </a>
      <a class="icon-card" href={`${base}Resume-BURAK-YUKSEL.pdf`} download>
        <div class="icon-flip">
          <div class="icon-face icon-front">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 3v12" />
              <path d="M7 11l5 5 5-5" />
              <path d="M5 19h14" />
            </svg>
          </div>
          <div class="icon-face icon-back">Download CV</div>
        </div>
      </a>
      <a class="icon-card" href="https://www.linkedin.com/in/burak-yuksel96/" target="_blank" rel="noreferrer">
        <div class="icon-flip">
          <div class="icon-face icon-front">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
              <path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.2 8.1h4.6V24H.2zM8.4 8.1h4.4v2.2h.06c.62-1.2 2.14-2.47 4.42-2.47 4.73 0 5.6 3.11 5.6 7.15V24h-4.6v-7.42c0-1.77-.03-4.05-2.47-4.05-2.47 0-2.85 1.93-2.85 3.92V24H8.4z" />
            </svg>
          </div>
          <div class="icon-face icon-back">LinkedIn</div>
        </div>
      </a>
    </div>

    <div class="mobile-nav">
      <button class="mobile-nav-toggle" type="button" aria-label="Open site links" aria-expanded="false" aria-controls="mobileNavMenu">
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
        <span class="hamburger-line line-3"></span>
      </button>
      <div class="mobile-nav-panel" id="mobileNavMenu" aria-hidden="true">
        <a class="mobile-nav-item" href={base}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M3 11.5l9-7 9 7" />
            <path d="M6.5 10.5V20h11V10.5" />
          </svg>
          <span>Homepage</span>
        </a>
        <a class="mobile-nav-item" href={`${base}blog/`}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M5 4h10l4 4v12H5z" />
            <path d="M15 4v4h4" />
            <path d="M8 12h8" />
            <path d="M8 15h8" />
          </svg>
          <span>Blog</span>
        </a>
        <a class="mobile-nav-item" href="https://github.com/BYuksel96" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58 0-.29-.01-1.06-.02-2.09-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.35-1.77-1.35-1.77-1.11-.76.08-.74.08-.74 1.22.09 1.87 1.26 1.87 1.26 1.09 1.86 2.86 1.32 3.56 1.01.11-.8.43-1.32.78-1.62-2.67-.3-5.48-1.33-5.48-5.92 0-1.31.47-2.38 1.25-3.22-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.64.25 2.86.12 3.16.78.84 1.24 1.91 1.24 3.22 0 4.6-2.82 5.61-5.5 5.91.44.38.83 1.13.83 2.28 0 1.65-.02 2.98-.02 3.39 0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
          </svg>
          <span>GitHub</span>
        </a>
        <a class="mobile-nav-item" href={`${base}Resume-BURAK-YUKSEL.pdf`} download>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 3v12" />
            <path d="M7 11l5 5 5-5" />
            <path d="M5 19h14" />
          </svg>
          <span>Download CV</span>
        </a>
        <a class="mobile-nav-item" href="https://www.linkedin.com/in/burak-yuksel96/" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.2 8.1h4.6V24H.2zM8.4 8.1h4.4v2.2h.06c.62-1.2 2.14-2.47 4.42-2.47 4.73 0 5.6 3.11 5.6 7.15V24h-4.6v-7.42c0-1.77-.03-4.05-2.47-4.05-2.47 0-2.85 1.93-2.85 3.92V24H8.4z" />
          </svg>
          <span>LinkedIn Profile</span>
        </a>
      </div>
    </div>

    <main class="posts-main">
      <div class="posts-shell">
        <h1 class="posts-title">Blog Posts</h1>

        <div class="posts-list">
          {groups.map((group) => (
            <div class="posts-year-group">
              <div class="posts-year">{group.year}</div>
              <div class="posts-entries">
                {group.posts.map((post) => {
                  const { Content } = renderedBySlug.get(post.slug);
                  const routeSlug = post.data.canonicalSlug || post.slug;
                  const rowDate = formatRowDate(post.data.pubDate);
                  const modalDate = formatModalDate(post.data.pubDate);
                  const readMinutes = estimateReadMinutes(post.body || '');
                  const meta = `${modalDate} - ${readMinutes} min read`;
                  const sharePath = `${base}blog/${routeSlug}/`;
                  return (
                    <div class="post-entry">
                      <a
                        class="post-row"
                        href={`${base}blog/${routeSlug}/`}
                        data-slug={post.slug}
                        data-title={post.data.title}
                        data-meta={meta}
                        data-description={post.data.description}
                        data-share-path={sharePath}
                      >
                        <span class="post-row-title">{post.data.title}</span>
                        <span class="post-row-date">{rowDate}</span>
                      </a>
                      <div class="post-content" data-post-content={post.slug} hidden>
                        <Content />
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>

    <div class="post-modal-backdrop" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="post-modal" role="document">
        <header class="post-modal-head">
          <div class="post-modal-meta" id="postModalMeta"></div>
          <div class="post-modal-actions">
            <button
              class="post-modal-share"
              type="button"
              aria-label="Share post"
              aria-controls="postModalSharePanel"
              aria-expanded="false"
            >
              Share
            </button>
            <button class="post-modal-close" type="button" aria-label="Close post">X</button>
          </div>
        </header>
        <div class="post-modal-share-panel" id="postModalSharePanel" aria-hidden="true">
          <button class="post-modal-share-option" type="button" data-share-action="copy">
            🔗 Copy Link
          </button>
          <button class="post-modal-share-option" type="button" data-share-action="linkedin">
            <span class="linkedin-icon" aria-hidden="true">in</span>
            Share on LinkedIn
          </button>
        </div>
        <h2 class="post-modal-title" id="postModalTitle"></h2>
        <div class="post-modal-body" id="postModalBody"></div>
        <button class="post-modal-scroll" type="button" aria-label="Scroll to bottom">V</button>
      </div>
    </div>
    <div class="post-copy-toast" id="postCopyToast" role="status" aria-live="polite">Link Copied</div>
  </div>

  <script>
    if (typeof window !== 'undefined') {
      window.addEventListener('DOMContentLoaded', () => {
        const backdrop = document.querySelector('.post-modal-backdrop');
        const modal = document.querySelector('.post-modal');
        const metaEl = document.getElementById('postModalMeta');
        const titleEl = document.getElementById('postModalTitle');
        const bodyEl = document.getElementById('postModalBody');
        const closeBtn = document.querySelector('.post-modal-close');
        const shareBtn = document.querySelector('.post-modal-share');
        const sharePanel = document.getElementById('postModalSharePanel');
        const copyToast = document.getElementById('postCopyToast');
        const scrollBtn = document.querySelector('.post-modal-scroll');
        const mobileNav = document.querySelector('.mobile-nav');
        const mobileNavToggle = document.querySelector('.mobile-nav-toggle');
        const mobileNavPanel = document.querySelector('.mobile-nav-panel');
        const linkedInShareText =
          'Checkout this latest post that I just read by Burak Yuksel! Definitely worth the read!';
        let activeShareUrl = '';
        let copyToastTimer = null;

        const setMobileNavOpen = (isOpen) => {
          if (!mobileNav || !mobileNavToggle || !mobileNavPanel) return;
          mobileNav.classList.toggle('open', isOpen);
          mobileNavToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          mobileNavPanel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        };

        const setSharePanelOpen = (isOpen) => {
          if (!modal || !sharePanel || !shareBtn) return;
          modal.classList.toggle('share-open', isOpen);
          sharePanel.classList.toggle('active', isOpen);
          sharePanel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
          shareBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          requestAnimationFrame(() => updateScrollHint());
        };

        const showCopyToast = () => {
          if (!copyToast) return;
          copyToast.classList.add('visible');
          if (copyToastTimer) window.clearTimeout(copyToastTimer);
          copyToastTimer = window.setTimeout(() => {
            copyToast.classList.remove('visible');
          }, 1600);
        };

        const copyToClipboard = async (text) => {
          if (!text) return false;
          if (navigator.clipboard?.writeText) {
            try {
              await navigator.clipboard.writeText(text);
              return true;
            } catch {
              // Fallback handled below.
            }
          }
          const helper = document.createElement('textarea');
          helper.value = text;
          helper.setAttribute('readonly', 'true');
          helper.style.position = 'absolute';
          helper.style.left = '-9999px';
          document.body.appendChild(helper);
          helper.select();
          const copied = document.execCommand('copy');
          document.body.removeChild(helper);
          return copied;
        };

        const openLinkedInShare = () => {
          if (!activeShareUrl) return;
          const prefilled = `${linkedInShareText} ${activeShareUrl}`;
          const linkedInUrl = `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(prefilled)}`;
          window.open(linkedInUrl, '_blank', 'noopener,noreferrer');
        };

        const openModal = (trigger) => {
          if (!backdrop || !modal || !metaEl || !titleEl || !bodyEl) return;
          const slug = trigger.dataset.slug;
          const meta = trigger.dataset.meta || '';
          const title = trigger.dataset.title || '';
          const description = trigger.dataset.description || '';
          const sharePath = trigger.dataset.sharePath || '';
          const content = document.querySelector(`[data-post-content="${slug}"]`);
          if (!content) return;
          metaEl.textContent = meta;
          titleEl.textContent = title;
          activeShareUrl = sharePath ? new URL(sharePath, window.location.origin).toString() : window.location.href;
          const tldr = description
            ? `<p class="post-modal-tldr"><span>TL;DR</span> ${description}</p>`
            : '';
          bodyEl.innerHTML = `${tldr}${content.innerHTML}`;
          setSharePanelOpen(false);
          backdrop.classList.add('active');
          modal.classList.add('active');
          backdrop.setAttribute('aria-hidden', 'false');
          bodyEl.scrollTop = 0;
          requestAnimationFrame(() => updateScrollHint());
        };

        const closeModal = () => {
          if (!backdrop || !modal) return;
          setSharePanelOpen(false);
          activeShareUrl = '';
          modal.classList.remove('active');
          backdrop.classList.remove('active');
          backdrop.setAttribute('aria-hidden', 'true');
        };

        const updateScrollHint = () => {
          if (!bodyEl || !scrollBtn) return;
          const remaining = bodyEl.scrollHeight - bodyEl.scrollTop - bodyEl.clientHeight;
          const shouldShow = bodyEl.scrollHeight > bodyEl.clientHeight && remaining > 8;
          scrollBtn.classList.toggle('visible', shouldShow);
        };

        document.addEventListener('click', (event) => {
          const trigger = event.target instanceof Element ? event.target.closest('.post-row') : null;
          if (trigger) {
            event.preventDefault();
            openModal(trigger);
            return;
          }
          if (event.target === backdrop) closeModal();
          const isShareOpen = !!sharePanel?.classList.contains('active');
          const isModalOpen = !!modal?.classList.contains('active');
          const targetNode = event.target;
          if (isShareOpen && isModalOpen && targetNode instanceof Node && modal && sharePanel) {
            const clickedInsideModal = modal.contains(targetNode);
            const clickedSharePanel = sharePanel.contains(targetNode);
            const clickedShareButton = !!shareBtn?.contains(targetNode);
            if (clickedInsideModal && !clickedSharePanel && !clickedShareButton) {
              setSharePanelOpen(false);
            }
          }
          if (mobileNav?.classList.contains('open') && targetNode instanceof Node && !mobileNav.contains(targetNode)) {
            setMobileNavOpen(false);
          }
        });

        closeBtn?.addEventListener('click', closeModal);
        shareBtn?.addEventListener('click', () => {
          if (!sharePanel) return;
          setSharePanelOpen(!sharePanel.classList.contains('active'));
        });
        sharePanel?.addEventListener('click', async (event) => {
          const option = event.target instanceof Element ? event.target.closest('[data-share-action]') : null;
          if (!option) return;
          const action = option.getAttribute('data-share-action');
          if (action === 'copy') {
            const didCopy = await copyToClipboard(activeShareUrl);
            setSharePanelOpen(false);
            if (didCopy) showCopyToast();
            return;
          }
          if (action === 'linkedin') {
            setSharePanelOpen(false);
            openLinkedInShare();
          }
        });
        scrollBtn?.addEventListener('click', () => {
          if (!bodyEl) return;
          bodyEl.scrollTo({ top: bodyEl.scrollHeight, behavior: 'smooth' });
        });
        bodyEl?.addEventListener('scroll', () => {
          setSharePanelOpen(false);
          updateScrollHint();
        });
        mobileNavToggle?.addEventListener('click', () => {
          if (!mobileNav) return;
          setMobileNavOpen(!mobileNav.classList.contains('open'));
        });
        mobileNavPanel?.addEventListener('click', (event) => {
          const navItem = event.target instanceof Element ? event.target.closest('.mobile-nav-item') : null;
          if (navItem) {
            setMobileNavOpen(false);
          }
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeModal();
            setMobileNavOpen(false);
          }
        });
      });
    }
  </script>
</BaseLayout>
