---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.flatMap((post) => {
    const routeSlugs = [...new Set([post.data.canonicalSlug, post.slug].filter(Boolean))];

    return routeSlugs.map((routeSlug) => ({
      params: { slug: routeSlug },
      props: {
        deepLinkSlug: routeSlug,
        title: post.data.title,
        description: post.data.description,
      },
    }));
  });
}

const { deepLinkSlug, title, description } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const rootHref = base.endsWith('/') ? base : `${base}/`;
const targetHref = `${rootHref}#blog=${encodeURIComponent(deepLinkSlug)}`;
const redirectScript = `window.location.replace(${JSON.stringify(targetHref)});`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${targetHref}`} />
    <link rel="canonical" href={rootHref} />
    <link rel="alternate" href={targetHref} />
    <title>{`Opening ${title} | Blog.exe`}</title>
    <script is:inline set:html={redirectScript}></script>
  </head>
  <body>
    <main>
      <p>Opening <a href={targetHref}>{title}</a> in Blog.exe.</p>
    </main>
  </body>
</html>
